{
  "name": "beaver-valley",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "overview": "node scripts/overview/build.mjs",
    "overview:refresh": "node scripts/overview/build.mjs --refresh",
    "overview:check": "node scripts/overview/build.mjs --check",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run overview:check && npm run lint && npm run typecheck && npm test && npm run build",
    "playtest": "node scripts/playtest/play.mjs",
    "playtest:late": "node scripts/playtest/late.mjs",
    "playtest:touch": "node scripts/playtest/touch.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
